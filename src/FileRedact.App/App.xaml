<Application x:Class="FileRedact.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:FileRedact.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <conv:CategoryToBrushConverter x:Key="CategoryBrush" />
        <conv:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <conv:NullToVisibilityConverter x:Key="NotNullToCollapsed" Invert="True" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisible" />
        <conv:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />

        <SolidColorBrush x:Key="AcceptedFill" Color="#66FACC15" />
        <SolidColorBrush x:Key="ProposedFill" Color="#1A3B82F6" />
        <SolidColorBrush x:Key="RedactedFill" Color="#FF000000" />

        <!-- A highlight rectangle: yellow when selected for redaction, faint dashed outline when only proposed,
             solid black when the reviewer switches on the preview. -->
        <Style x:Key="HighlightStyle" TargetType="Rectangle">
            <Setter Property="Fill" Value="{StaticResource AcceptedFill}" />
            <Setter Property="Stroke" Value="{Binding Finding.Category, Converter={StaticResource CategoryBrush}}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="{Binding Finding.ToolTip}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Finding.Accepted}" Value="False">
                    <Setter Property="Fill" Value="{StaticResource ProposedFill}" />
                    <Setter Property="StrokeDashArray" Value="3 2" />
                    <Setter Property="Opacity" Value="0.85" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Finding.Accepted}" Value="True" />
                        <Condition Binding="{Binding DataContext.PreviewRedactions, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Fill" Value="{StaticResource RedactedFill}" />
                    <Setter Property="Stroke" Value="Black" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Finding.Accepted}" Value="False" />
                        <Condition Binding="{Binding DataContext.PreviewRedactions, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="MinWidth" Value="48" />
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2,0" />
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>
    </Application.Resources>
</Application>
