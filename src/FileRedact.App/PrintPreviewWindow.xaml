<Window x:Class="FileRedact.App.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Print preview - FileRedact"
        Width="1000" Height="820" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6">
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding PrintCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Window.InputBindings>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="PageInfo" VerticalAlignment="Center" Foreground="#4B5563" Margin="0,0,16,0" />
                    <Button Content="−" Click="ZoomOut_Click" MinWidth="32" Padding="8,4" Margin="2,0" />
                    <Button x:Name="ZoomLabel" Content="100%" Click="ZoomReset_Click" MinWidth="56" Padding="8,4" Margin="2,0" ToolTip="Reset zoom" />
                    <Button Content="+" Click="ZoomIn_Click" MinWidth="32" Padding="8,4" Margin="2,0" />
                    <Button Content="Fit width" Click="FitWidth_Click" Padding="10,4" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PrintButton" Content="Print…" Click="Print_Click" FontWeight="SemiBold" Padding="16,5" IsDefault="True"
                            ToolTip="Choose a printer and print these pages (Ctrl+P)" />
                    <Button Content="Close" Click="Close_Click" Padding="12,5" Margin="8,0,0,0" IsCancel="True" />
                    <TextBlock x:Name="Note" VerticalAlignment="Center" Margin="18,0,0,0" Foreground="#4B5563"
                               Text="This is exactly what will be printed: selected items are blacked out." />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="160" Height="10" Minimum="0" Maximum="1" Visibility="Collapsed" VerticalAlignment="Center" />
                <TextBlock x:Name="Status" VerticalAlignment="Center" Foreground="#374151" />
            </DockPanel>
        </Border>
        <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Scroll_PreviewMouseWheel" ScrollChanged="Scroll_ScrollChanged">
            <ItemsControl x:Name="PagesHost" Margin="24,16" HorizontalAlignment="Center">
                <ItemsControl.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                </ItemsControl.LayoutTransform>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="{Binding Header}" Foreground="#6B7280" FontSize="12" Margin="2,0,0,4" />
                            <Border BorderBrush="#9CA3AF" BorderThickness="1" Background="White" Width="{Binding Width}" Height="{Binding Height}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <Grid>
                                    <Image Source="{Binding Image}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <TextBlock Text="Preparing page…" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding Placeholder}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
