<Window x:Class="FileRedact.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileRedact update available"
        Width="560" Height="460" MinWidth="460" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="#F9FAFB">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Headline" FontSize="18" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" x:Name="VersionLine" Foreground="#4B5563" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock Grid.Row="2" Text="What's new" FontWeight="SemiBold" Foreground="#374151" Margin="0,14,0,4" />
        <Border Grid.Row="3" BorderBrush="#E5E7EB" BorderThickness="1" Background="White">
            <TextBox x:Name="Notes" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="10"
                     VerticalScrollBarVisibility="Auto" FontFamily="Segoe UI" Background="White" />
        </Border>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock x:Name="ProgressText" Foreground="#4B5563" Visibility="Collapsed" />
            <ProgressBar x:Name="Progress" Height="10" Margin="0,4,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
            <TextBlock Margin="0,6,0,0">
                <Hyperlink x:Name="PageLink" Click="PageLink_Click">Open the release page on GitHub</Hyperlink>
            </TextBlock>
        </StackPanel>

        <DockPanel Grid.Row="5" Margin="0,16,0,0">
            <Button x:Name="SkipButton" DockPanel.Dock="Left" Content="Skip this version" Padding="12,6" Click="Skip_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LaterButton" Content="Remind me later" Padding="12,6" Margin="0,0,8,0" Click="Later_Click" IsCancel="True" />
                <Button x:Name="DownloadButton" Content="Download update" Padding="14,6" FontWeight="SemiBold" Click="Download_Click" IsDefault="True" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
