<Window x:Class="FileRedact.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileRedact update"
        Width="520" SizeToContent="Height" MinHeight="220"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="True"
        Background="#F9FAFB">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="Headline" FontSize="18" FontWeight="SemiBold" Foreground="#111827" TextWrapping="Wrap" />
        <TextBlock Grid.Row="1" x:Name="Detail" Foreground="#4B5563" Margin="0,6,0,0" TextWrapping="Wrap" />

        <Expander Grid.Row="2" x:Name="NotesExpander" Header="What's new" Margin="0,12,0,0" IsExpanded="False">
            <Border BorderBrush="#E5E7EB" BorderThickness="1" Background="White" Margin="0,4,0,0" MaxHeight="180">
                <TextBox x:Name="Notes" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="10" VerticalScrollBarVisibility="Auto" Background="White" />
            </Border>
        </Expander>

        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="ProgressText" Foreground="#4B5563" />
            <ProgressBar x:Name="Progress" Height="12" Margin="0,6,0,0" Minimum="0" Maximum="1" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="LaterButton" Content="Not now" Padding="14,7" Margin="0,0,8,0" Click="Later_Click" IsCancel="True" MinWidth="100" />
            <Button x:Name="InstallButton" Content="Install and restart" Padding="16,7" FontWeight="SemiBold" Click="Install_Click" IsDefault="True" MinWidth="150" />
        </StackPanel>
    </Grid>
</Window>
